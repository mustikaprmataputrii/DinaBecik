# ============================================================================
#  Dina Becik — contoh environment variables
# ============================================================================
#  CARA PAKAI:
#    1. Salin file ini menjadi `.env.local`
#    2. Isi nilainya dari Firebase Console
#    3. `.env.local` TIDAK akan masuk repo (sudah di .gitignore)
#
#  ⚠️ CATATAN KEAMANAN:
#  Nilai apiKey di bawah AMAN dipublikasikan — Firebase memang dirancang
#  begitu. Yang BERBAHAYA adalah serviceAccountKey.json (admin SDK).
#  JANGAN pernah menaruh service account key di file ini atau di repo.
# ============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_DINA_API_URL=
VITE_FIREBASE_EMAIL_SESEPUH=
VITE_FIREBASE_EMAIL_ORANGTUA=
VITE_FIREBASE_EMAIL_WO=
